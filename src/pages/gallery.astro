---
import { createClient } from "@/lib/supabase";
import { listFolders, type FolderWithCount } from "@/lib/archive/folders";
import { listPhotos, type PhotoCardData } from "@/lib/archive/photos";
import Layout from "@/layouts/Layout.astro";
import ArchiveView from "@/components/archive/ArchiveView";
import AccountMenu from "@/components/auth/AccountMenu";

Astro.response.headers.set("Cache-Control", "private, no-store");

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let initialFolders: FolderWithCount[] = [];
let initialPhotos: PhotoCardData[] = [];

if (user && supabase) {
  [initialFolders, initialPhotos] = await Promise.all([
    listFolders(supabase, user.id).catch(() => []),
    listPhotos(supabase, { userId: user.id }).catch(() => []),
  ]);
}
---

<Layout title="Gallery — Landmark Lore">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
    <div class="w-full max-w-4xl">
      <div class="relative z-10 mb-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="text-sm text-white/60 transition-colors hover:text-white">← Dashboard</a>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Landmark Lore
          </h1>
        </div>
        <AccountMenu email={user?.email ?? ""} client:only="react" />
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <ArchiveView initialFolders={initialFolders} initialPhotos={initialPhotos} client:only="react" />
      </div>
    </div>
  </div>
</Layout>
