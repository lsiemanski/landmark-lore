---
import Layout from "@/layouts/Layout.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import { ServerError } from "@/components/auth/ServerError";

const ERROR_MESSAGES: Record<string, string> = {
  link_invalid: "Your password reset link has expired or is invalid — request a new one below.",
  session_expired: "Your session has expired — request a new password reset link below.",
};

const sent = Astro.url.searchParams.has("sent");
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? errorCode) : null;
---

<Layout title="Forgot password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Forgot password
      </h1>
      {
        sent ? (
          <div class="space-y-4 text-center text-sm text-blue-100/80">
            <p>Check your inbox — a password reset link is on its way.</p>
            <p>
              <a href="/auth/signin" class="text-purple-300 hover:underline">
                Back to sign in
              </a>
            </p>
          </div>
        ) : (
          <div class="space-y-4">
            <ServerError message={errorMessage} />
            <ForgotPasswordForm serverError={null} client:load />
          </div>
        )
      }
      {
        !sent && (
          <p class="mt-4 text-center text-sm text-blue-100/60">
            Remember your password?{" "}
            <a href="/auth/signin" class="text-purple-300 hover:underline">
              Sign in
            </a>
          </p>
        )
      }
    </div>
  </div>
</Layout>

<script>
  if (window.location.hash) {
    history.replaceState(null, "", window.location.pathname + window.location.search);
  }
</script>
