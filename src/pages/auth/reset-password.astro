---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

if (!Astro.locals.user) {
  return Astro.redirect("/auth/forgot-password?error=session_expired");
}

const ERROR_MESSAGES: Record<string, string> = {
  passwords_mismatch: "Passwords do not match — please try again.",
  update_failed: "Could not update your password — your reset link may have expired. Request a new one.",
};

const errorCode = Astro.url.searchParams.get("error");
const error = errorCode ? (ERROR_MESSAGES[errorCode] ?? errorCode) : null;
---

<Layout title="Set new password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Set new password
      </h1>
      <ResetPasswordForm serverError={error} client:load />
    </div>
  </div>
</Layout>
