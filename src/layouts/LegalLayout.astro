---
import Layout from "@/layouts/Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    lastUpdated: string;
  };
}

const { title, lastUpdated } = Astro.props.frontmatter;
---

<Layout title={title}>
  <div class="bg-cosmic min-h-screen p-4 pt-12">
    <div class="mx-auto w-full max-w-2xl">
      <div class="relative z-10 mb-8 flex items-center justify-between">
        <a
          href="/"
          class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent"
        >
          Landmark Lore
        </a>
        <a href="/" class="text-sm text-white/60 transition-colors hover:text-white">&larr; Back</a>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          {title}
        </h1>
        <p class="mt-1 mb-6 text-sm text-blue-100/50">Last updated: {lastUpdated}</p>
        <article class="legal-content">
          <slot />
        </article>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .legal-content {
    color: rgb(219 234 254 / 0.85); /* blue-100/85 */
    line-height: 1.7;
  }
  .legal-content h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(233 213 255); /* purple-200 */
  }
  .legal-content h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgb(219 234 254); /* blue-100 */
  }
  .legal-content p {
    margin-bottom: 1rem;
  }
  .legal-content ul {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-content li {
    margin-bottom: 0.375rem;
  }
  .legal-content a {
    color: rgb(216 180 254); /* purple-300 */
    text-decoration: underline;
  }
  .legal-content strong {
    color: rgb(255 255 255 / 0.95);
  }
</style>
