---
// Public landing page shown at "/" to logged-out visitors.
// Logged-in users see the app (see src/pages/index.astro).
---

<div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
  <div class="w-full max-w-3xl">
    <header class="relative z-10 mb-12 flex items-center justify-between">
      <a href="/" class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Landmark Lore
      </a>
      <a href="/auth/signin" class="text-sm text-white/60 transition-colors hover:text-white">Sign in</a>
    </header>

    <section class="text-center">
      <h1 class="mx-auto max-w-2xl text-4xl font-bold text-white sm:text-5xl">Remember every place you photographed</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-blue-100/70">
        Upload a travel photo and Landmark Lore identifies the landmark, artwork, or monument in it — then saves it to a
        private archive with the story behind it.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a
          href="/auth/signup"
          class="rounded-xl bg-gradient-to-r from-blue-500 to-purple-500 px-6 py-3 font-medium text-white transition-opacity hover:opacity-90"
        >
          Get started — it's free
        </a>
        <a href="/auth/signin" class="text-sm text-blue-100/70 transition-colors hover:text-white">
          I already have an account
        </a>
      </div>
    </section>

    <section class="mt-16 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <div class="text-sm font-semibold text-purple-200">1 · Upload</div>
        <p class="mt-2 text-sm text-blue-100/70">
          Pick a photo of a building, statue, or artwork from your device. No metadata or notes needed.
        </p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <div class="text-sm font-semibold text-purple-200">2 · Identify</div>
        <p class="mt-2 text-sm text-blue-100/70">
          AI names the subject and explains why it matters — its history and cultural context. Ask follow-up questions
          anytime.
        </p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <div class="text-sm font-semibold text-purple-200">3 · Save</div>
        <p class="mt-2 text-sm text-blue-100/70">
          Keep the photo and its story in a private archive, organised into folders only you can see.
        </p>
      </div>
    </section>

    <footer class="mt-16 text-center text-xs text-white/40">
      <a href="/terms" class="transition-colors hover:text-white/70">Terms</a> &middot;
      <a href="/privacy" class="transition-colors hover:text-white/70">Privacy</a>
    </footer>
  </div>
</div>
